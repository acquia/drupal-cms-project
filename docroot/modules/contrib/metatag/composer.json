{
  "name": "drupal/metatag",
  "description": "Manage meta tags for all entities.",
  "license": "GPL-2.0-or-later",
  "type": "drupal-module",
  "keywords": [
    "Drupal",
    "seo"
  ],
  "authors": [
    {
      "name": "See contributors",
      "homepage": "https://www.drupal.org/node/640498/committers",
      "role": "Developer"
    }
  ],
  "homepage": "https://www.drupal.org/project/metatag",
  "support": {
    "issues": "https://www.drupal.org/project/issues/metatag",
    "source": "https://git.drupalcode.org/project/metatag",
    "docs": "https://www.drupal.org/docs/8/modules/metatag"
  },
  "require": {
    "drupal/core": "^10.3 || ^11",
    "drupal/token": "^1.17"
  },
  "require-dev": {
    "drupal/diff": "*",
    "drupal/forum": "^1.0",
    "drupal/graphql": "^3",
    "drupal/hal": "^1 || ^2 || ^9",
    "drupal/page_manager": "^4.0",
    "drupal/redirect": "^1.0",
    "ergebnis/composer-normalize": "*"
  },
  "suggest": {
    "drupal/token_browser": "A significantly improved token interface for Drupal 11.3+.",
    "drupal/token_or": "Allows providing a fallback option for when a token is empty to use either another token or a fixed value."
  },
  "conflict": {
    "drupal/schema_metatag": "< 3.1.0"
  },
  "minimum-stability": "dev",
  "extra": {
    "composer-normalize": {
      "indent-size": 2,
      "indent-style": "space"
    }
  }
}
