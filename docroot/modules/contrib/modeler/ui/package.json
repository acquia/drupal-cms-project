{
  "name": "drupal-workflow-modeler",
  "version": "1.0.0",
  "type": "module",
  "description": "React Flow based workflow modeler for Drupal",
  "scripts": {
    "build": "./build.sh",
    "build:production": "./build.sh --production",
    "build:novalidate": "./build.sh --no-validate",
    "build:standalone": "./build.sh --standalone",
    "build:standalone:production": "./build.sh --production --standalone",
    "type-check": "node_modules/typescript/bin/tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "dev": "npm run lint && npm run type-check && npm run build",
    "test": "jest --config tests/jest.config.cjs",
    "test:watch": "jest --config tests/jest.config.cjs --watch",
    "test:coverage": "jest --config tests/jest.config.cjs --coverage",
    "test:ci": "jest --config tests/jest.config.cjs --ci --coverage --maxWorkers=2",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o tests/storybook-static",
    "test-storybook": "test-storybook",
    "test-storybook:a11y": "test-storybook --failOnConsole false",
    "test-storybook:ci": "./tests/test-storybook-ci.sh",
    "e2e": "playwright test --config tests/playwright.config.ts",
    "e2e:ui": "playwright test --config tests/playwright.config.ts --ui",
    "e2e:headed": "playwright test --config tests/playwright.config.ts --headed",
    "e2e:debug": "playwright test --config tests/playwright.config.ts --debug",
    "e2e:report": "playwright show-report tests/playwright-report",
    "e2e:codegen": "playwright codegen",
    "e2e:server": "npx tsx tests/e2e/test-server.ts"
  },
  "dependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.1",
    "@reactflow/background": "^11.3.0",
    "@reactflow/controls": "^11.2.0",
    "@reactflow/minimap": "^11.7.0",
    "@reactflow/node-resizer": "^2.2.0",
    "@reactflow/node-toolbar": "^1.3.0",
    "@storybook/addon-a11y": "^8.6.15",
    "@storybook/addon-essentials": "^8.6.15",
    "@storybook/addon-interactions": "^8.6.15",
    "@storybook/react": "^8.6.15",
    "@storybook/react-vite": "^8.6.15",
    "@storybook/test": "^8.6.15",
    "@storybook/test-runner": "^0.23.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.0.5",
    "@types/jest": "^29.5.14",
    "@types/jest-axe": "^3.5.9",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "axe-playwright": "^2.2.2",
    "classnames": "^2.3.2",
    "dompurify": "^3.3.1",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "http-server": "^14.1.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "js-yaml": "^4.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.12.0",
    "reactflow": "^11.10.0",
    "storybook": "^8.6.15",
    "ts-jest": "^29.4.6",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "uuid": "^14.0.1",
    "wait-on": "^9.0.3",
    "zustand": "^4.4.7"
  },
  "overrides": {
    "uuid": "$uuid"
  }
}
