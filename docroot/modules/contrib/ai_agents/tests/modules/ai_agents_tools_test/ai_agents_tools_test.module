<?php

/**
 * @file
 * Hook implementations for ai_agents_tools_test.
 */

use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Field\FieldItemListInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Render\BubbleableMetadata;
use Drupal\Core\Session\AccountInterface;
use Drupal\ai_agents_tools_test\Hook\AiAgentsToolsTestHooks;

/**
 * Implements hook_entity_field_access().
 *
 * Drupal core versions without OOP hook attribute discovery (e.g. Drupal 10)
 * never invoke AiAgentsToolsTestHooks::entityFieldAccess() via its #[Hook]
 * attribute alone, so a procedural implementation is required here too.
 */
#[LegacyHook]
function ai_agents_tools_test_entity_field_access(string $operation, FieldDefinitionInterface $field_definition, AccountInterface $account, ?FieldItemListInterface $items = NULL): AccessResultInterface {
  return \Drupal::service(AiAgentsToolsTestHooks::class)->entityFieldAccess($operation, $field_definition, $account, $items);
}

/**
 * Implements hook_token_info().
 */
#[LegacyHook]
function ai_agents_tools_test_token_info(): array {
  return \Drupal::service(AiAgentsToolsTestHooks::class)->tokenInfo();
}

/**
 * Implements hook_tokens().
 */
#[LegacyHook]
function ai_agents_tools_test_tokens(string $type, array $tokens, array $data = [], array $options = [], ?BubbleableMetadata $bubbleable_metadata = NULL): array {
  return \Drupal::service(AiAgentsToolsTestHooks::class)->tokens($type, $tokens, $data, $options, $bubbleable_metadata);
}
