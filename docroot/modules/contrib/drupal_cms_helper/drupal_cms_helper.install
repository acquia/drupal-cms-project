<?php

/**
 * @file
 * Contains install-time hooks for Drupal CMS Helper.
 */

declare(strict_types=1);

use Drupal\Core\Menu\MenuLinkManagerInterface;
use Drupal\drupal_cms_helper\TelemetryManager;

/**
 * Implements hook_install().
 */
function drupal_cms_helper_install(): void {
  // This is a shim to ensure that all menu link definitions are up-to-date so
  // that, if they are involved in config actions (e.g., the config object
  // `core.menu.static_menu_link_overrides`), the config will be valid.
  Drupal::service(MenuLinkManagerInterface::class)->rebuild();

  // Respect the DRUPAL_CMS_TELEMETRY environment variable if it's set.
  // Only `0` and `1` are valid values, since they cast cleanly to boolean.
  $value = getenv('DRUPAL_CMS_TELEMETRY');
  if (is_string($value)) {
    Drupal::service(TelemetryManager::class)->status((bool) $value);
  }
}
