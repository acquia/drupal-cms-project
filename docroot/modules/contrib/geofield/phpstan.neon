# Configuration file for PHPStan static code checking, see https://phpstan.org.

includes:
  - phar://phpstan.phar/conf/bleedingEdge.neon
  - phpstan-baseline.neon

parameters:
  level: 2
  paths:
    - .
  bootstrapFiles:
    - phpstan-bootstrap.php
  excludePaths:
    # Extends a migrate_drupal class. Drupal 12 core no longer ships
    # migrate_drupal, and the plugin is only discovered when it is installed.
    - src/Plugin/migrate/field/Geofield.php
  ignoreErrors:
    - "#^Unsafe usage of new static#"
