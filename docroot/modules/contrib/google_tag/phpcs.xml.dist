<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="google_tag">
  <description>PHP CodeSniffer configuration for Google Tag.</description>
  <!-- JavaScript is checked by eslint. -->
  <arg name="extensions" value="engine,inc,info,install,module,php,profile,test,theme,yml"/>
  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>
</ruleset>
