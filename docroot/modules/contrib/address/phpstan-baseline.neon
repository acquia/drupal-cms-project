parameters:
	ignoreErrors:
		-
			message: """
				#^Call to deprecated method getSubdivisionDepth\\(\\) of class CommerceGuys\\\\Addressing\\\\AddressFormat\\\\AddressFormat\\:
				Use getSubdivisionDataFields\\(\\) instead\\.$#
