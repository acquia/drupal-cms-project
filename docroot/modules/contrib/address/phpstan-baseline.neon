		-
			message: "#^Access to an undefined property Drupal\\\\address\\\\Plugin\\\\Field\\\\FieldType\\\\ZoneItem\\:\\:\\$value\\.$#"
			count: 1
			path: src/Plugin/Field/FieldType/ZoneItem.php

		-
			message: """
				#^Call to deprecated method renderPlain\\(\\) of interface Drupal\\\\Core\\\\Render\\\\RendererInterface\\:
				in drupal\\:10\\.3\\.0 and is removed from drupal\\:12\\.0\\.0\\. Use
				  \\\\Drupal\\\\Core\\\\Render\\\\RendererInterface\\:\\:renderInIsolation\\(\\) instead\\.$#
			"""
			count: 1
			path: src/Plugin/diff/Field/AddressFieldBuilder.php

		-
			message: """
				#^Call to deprecated method getSubdivisionDepth\\(\\) of class CommerceGuys\\\\Addressing\\\\AddressFormat\\\\AddressFormat\\:
				Use getSubdivisionDataFields\\(\\) instead\\.$#
